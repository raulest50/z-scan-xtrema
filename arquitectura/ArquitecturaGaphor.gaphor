<Core:StyleSheet id="58d6989a-66f8-11ec-b4c8-0456e5e540ed">
<styleSheet>
<val>diagram {
  /* line-style: sloppy 0.3; */
}

/* Devices ubicados directamente en el diagrama */
diagram &gt; node {
  justify-content: start;
  text-align: left;
  padding: 12;
  line-width: 3;
}

/* Nodes contenidos dentro de Devices u otros Nodes */
node &gt; node {
  justify-content: start;
  text-align: left;
  padding: 12;
  line-width: 2;
}

/* Todos los Artifacts */
artifact {
  justify-content: start;
  text-align: left;
  padding: 12;
  line-width: 1;
}</val>
</styleSheet>
</Core:StyleSheet>
