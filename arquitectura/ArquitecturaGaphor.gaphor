<?xml version="1.0" encoding="utf-8"?>
<gaphor xmlns="https://gaphor.org/model" xmlns:Core="https://gaphor.org/modelinglanguage/Core" xmlns:UML="https://gaphor.org/modelinglanguage/UML" version="4" gaphor-version="3.3.2">
<model>
<Core:StyleSheet id="58d6989a-66f8-11ec-b4c8-0456e5e540ed">
<styleSheet>
<val>/*
 * Z-Scan-Xtrema — Deployment Architecture
 * Tema profesional adaptativo para Gaphor.
 *
 * Tema predeterminado: claro, también usado al exportar.
 * Tema oscuro: aplicado automáticamente por Gaphor.
 */

/* ============================================================
   PALETA PREDETERMINADA / EXPORTACIÓN / MODO CLARO
   ============================================================ */

* {
  --canvas: #f5f7fb;
  --ink: #1e293b;
  --muted: #64748b;
  --label-bg: #ffffff;

  --device-bg: #e8f1ff;
  --device-color: #1d4ed8;

  --node-bg: #e7f8f4;
  --node-color: #0f766e;

  --runtime-bg: #f1edff;
  --runtime-color: #6d28d9;

  --artifact-bg: #fff4d6;
  --artifact-color: #a16207;

  --connection: #64748b;
  --ethernet: #0284c7;
  --mechanical: #ea580c;

  --note-bg: #fffbea;
  --note-color: #a16207;
}

/* ============================================================
   MODO OSCURO
   ============================================================ */

@media dark-mode {
  * {
    --canvas: #0b1220;
    --ink: #e6edf7;
    --muted: #9aa9bd;
    --label-bg: #111b2e;

    --device-bg: #102a43;
    --device-color: #93c5fd;

    --node-bg: #0d302e;
    --node-color: #5eead4;

    --runtime-bg: #261b3f;
    --runtime-color: #c4b5fd;

    --artifact-bg: #382b12;
    --artifact-color: #fcd34d;

    --connection: #9aa9bd;
    --ethernet: #38bdf8;
    --mechanical: #fb923c;

    --note-bg: #302b12;
    --note-color: #fde68a;
  }
}

/* ============================================================
   LIENZO
   ============================================================ */

diagram {
  background-color: var(--canvas);
  color: var(--ink);
  font-family: sans;
  font-size: 14;
  line-style: normal;
}

/* ============================================================
   CONFIGURACIÓN GENERAL DE DEVICE Y NODE
   ============================================================ */

node {
  justify-content: start;
  text-align: left;
  vertical-align: top;

  padding: 14 16;
  min-width: 170;
  min-height: 100;

  line-width: 2;
  border-radius: 12;
}

/* ============================================================
   DEVICES FÍSICOS

   Kria KV260, Router, Stage Driver y Linear Stage.
   ============================================================ */

node[subject=device] {
  background-color: var(--device-bg);
  color: var(--device-color);
  line-width: 3;
}

/* ============================================================
   NODES / EXECUTION ENVIRONMENTS

   Primer nivel lógico: Linux.
   ============================================================ */

node[subject=node],
node[subject=executionenvironment] {
  background-color: var(--node-bg);
  color: var(--node-color);
  line-width: 2;
}

/* ============================================================
   RUNTIME ANIDADO

   Segundo nivel lógico: Python + PYNQ dentro de Linux.
   ============================================================ */

:is(
  node[subject=node],
  node[subject=executionenvironment]
) &gt; :is(
  node[subject=node],
  node[subject=executionenvironment]
) {
  background-color: var(--runtime-bg);
  color: var(--runtime-color);
  line-width: 2;
}

/* ============================================================
   TEXTO DE DEVICES Y NODES
   ============================================================ */

node name {
  font-size: large;
  font-weight: bold;
}

node stereotypes {
  font-size: small;
  font-weight: bold;
}

node from {
  font-size: x-small;
  font-style: italic;
}

/* ============================================================
   ARTIFACTS

   Backend, frontend compilado, .bit, .hwh, configuración, etc.
   ============================================================ */

artifact {
  background-color: var(--artifact-bg);
  color: var(--artifact-color);

  justify-content: start;
  text-align: left;
  vertical-align: top;

  min-width: 155;
  min-height: 72;

  line-width: 2;
  border-radius: 10;
}

artifact compartment:first-child {
  padding: 12 16;
}

artifact name {
  font-size: 14;
  font-weight: bold;
}

artifact stereotypes {
  font-size: small;
  font-weight: bold;
}

artifact from {
  font-size: x-small;
  font-style: italic;
}

/* ============================================================
   COMUNICACIONES
   ============================================================ */

association {
  color: var(--connection);
  line-width: 2;
}

/* Ethernet resaltado en azul */

association[name*=ethernet] {
  color: var(--ethernet);
  line-width: 3;
}

/* Cable físico D-sub resaltado en naranja */

association[name*=d-sub] {
  color: var(--mechanical);
  line-width: 3;
}

/* Dependencias y relaciones de despliegue */

dependency {
  color: var(--connection);
  line-width: 2;
  dash-style: 8 5;
}

/* Etiquetas de las conexiones */

:is(association, dependency) name {
  color: var(--ink);
  background-color: var(--label-bg);

  padding: 3 7;
  border-radius: 6;

  font-size: small;
  font-weight: bold;
}

/* ============================================================
   NOTAS
   ============================================================ */

comment {
  background-color: var(--note-bg);
  color: var(--note-color);

  padding: 10 12;
  border-radius: 8;
  line-width: 2;
}

comment body {
  white-space: normal;
  text-align: left;
}

commentline {
  color: var(--muted);
  dash-style: 6 4;
}

/* ============================================================
   INTERACCIÓN
   ============================================================ */

:is(node, artifact):hover {
  line-width: 3;
}

:is(node, artifact):focus {
  line-width: 4;
}




package {
    justify-content: start;
    text-align: center;
    padding: 24 12 8 12;
}

package name {
    text-align: center;
}





</val>
</styleSheet>
</Core:StyleSheet>
